{
  "name": "claude-buddy-statusline",
  "version": "0.2.3",
  "description": "A terminal buddy character for Claude Code — render-only ASCII companion injected into your statusline. Zero tokens, no hooks.",
  "keywords": [
    "claude",
    "claude-code",
    "terminal",
    "ascii",
    "statusline",
    "buddy"
  ],
  "homepage": "https://github.com/chae-dahee/claude-buddy",
  "repository": {
    "type": "git",
    "url": "https://github.com/chae-dahee/claude-buddy"
  },
  "bugs": {
    "url": "https://github.com/chae-dahee/claude-buddy/issues"
  },
  "author": "dahdaradanadat <cdh010126r@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "claude-buddy": "bin/claude-buddy.cjs"
  },
  "files": [
    "bin/",
    "dist/"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "node --test tests/*.test.js",
    "preuninstall": "claude-buddy setup --uninstall || true"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
